# ==============================================================================
# SkyVanta AI — Production Deployment Configuration Template
# Placeholders only. Do NOT commit real secrets or production credentials.
# ==============================================================================

# Runtime Deployment Environment: development | testing | production
SKYVANTA_ENV=production

# Server Binding
SKYVANTA_HOST=0.0.0.0
SKYVANTA_PORT=8080

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
SKYVANTA_LOG_LEVEL=INFO

# Allowed CORS Origins (comma-separated URLs, NO wildcard '*' in production)
SKYVANTA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Real-Time Telemetry Streaming Rate (Hz, 1.0 - 100.0)
SKYVANTA_TELEMETRY_RATE_HZ=20.0

# WebSocket Maximum Concurrent Client Connections
SKYVANTA_MAX_WS_CLIENTS=50

# Request Processing Timeout (seconds)
SKYVANTA_REQUEST_TIMEOUT_SEC=60.0

# WebSocket Idle Connection Timeout (seconds)
SKYVANTA_WS_IDLE_TIMEOUT_SEC=300.0

# Operational Metrics & Defensive Security Headers (true / false)
SKYVANTA_ENABLE_METRICS=true
SKYVANTA_ENABLE_SECURITY_HEADERS=true

# Debug Mode (strictly disabled in production)
SKYVANTA_DEBUG=false

# Immutable Safety Invariants (strictly disabled; cannot be overridden)
SKYVANTA_ALLOW_EXTERNAL=false
SKYVANTA_ALLOW_NETWORK_DOWNLOAD=false
